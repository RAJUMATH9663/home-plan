{
  "builds": [
    {
      "src": "homeservices/homeservices/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/homeservices/homeservices/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "homeservices.settings"
  }
}
